# ANVIK AI — environment variables (copy to .env.local and fill in)

# --- AI provider (server-side, never exposed to the browser) ---
GOOGLE_GENERATIVE_AI_API_KEY=
# Legacy alias also accepted by the server-side provider module.
GEMINI_API_KEY=
# Optional override for the Gemini base URL (defaults to Google's endpoint).
GEMINI_BASE_URL=
# Optional override for the answer model (defaults to the model in lib/provider.ts).
ANVIK_MODEL=
ANVIK_IMAGE_MODEL=

# --- Supabase (accounts, consent, per-user credits) ---
# Safe to expose the publishable/anon URL to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key — read-only public key, safe in the browser. Do NOT use a service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
# Server-only service role key — never expose to the browser. Used exclusively server-side
# for privileged writes (consent, credits, entitlements, history). Required in production;
# the server never falls back to an anon/publishable key.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy service key name (accepted by the server adapter).
SUPABASE_SERVICE_KEY=
# Anonymous key — only ever used by the browser account client (lib/auth.ts,
# lib/session.ts) with a verified user token. Never used for privileged writes.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Admin (paid-plan activation via WhatsApp enquiry — the only activation path) ---
# The x-anvik-admin-token header must equal this value. No online payment is processed.
ANVIK_ADMIN_TOKEN=

# --- Links / email ---
NEXT_PUBLIC_SITE_URL=
